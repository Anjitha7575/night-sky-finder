# Copy this file to .env (in this main project folder) and fill in your key.
# Never commit .env: it is already in .gitignore.

# Meta Model API key (from dev.meta.ai → API keys)
META_API_KEY=your-meta-model-api-key
META_MODEL=muse-spark-1.3

# meta = use Muse Spark. mock = simple rules, no key needed (for a quick try).
AI_MODE=meta

# Optional
# META_EFFORT=low                 # reasoning effort for Muse Spark
# SAMPLES_DIR=data/sample         # where the demo clips are (relative to backend/)
# FRONTEND_URL=https://your-site  # extra site allowed to call the API (CORS)
# WARM_UP=1                       # measure demo clips in the background at start
